# ── Smart Order environment ──────────────────────────────────
# Copy to .env and adjust. NEVER commit real secrets.

# Database (dev default: local SQLite)
# Production: PostgreSQL connection string, e.g.
# postgresql://user:pass@host/dbname?sslmode=require
DATABASE_URL="file:./db/smart-order.db"

# Canonical public URL (SEO, Open Graph, sitemap)
# Must be a REAL url or left unset — an empty string crashes new URL() in
# src/app/layout.tsx metadata (500s every page).
# NEXT_PUBLIC_SITE_URL="https://order.smart-link.ly"

# ── Bank transfer details (customer-facing, payment dialog) ──
# Shown to subscribers choosing the bank path; safe defaults are baked
# in when unset (src/components/payment/payment-dialog.tsx).
# NEXT_PUBLIC_BANK_NAME="مصرف التجارة والتنمية"
# NEXT_PUBLIC_BANK_ACCOUNT="0021-0045-3378-2901"
# NEXT_PUBLIC_BANK_HOLDER="شركة الربط الذكي"

# ── Support WhatsApp (login help dialog, terms, landing footer) ──
# E.164 without plus; default 218910089975 when unset.
# NEXT_PUBLIC_SUPPORT_WHATSAPP="218910089975"

# ── Seed route security gate (api/seed) ──────────────────────
# When set, POST /api/seed requires ?secret= to match; when unset the
# route falls back to platform-admin sessions only (never open).
# SEED_SECRET=""

# ── Self-host / proxy (optional) ─────────────────────────────
# Trust depth for X-Forwarded-For resolution behind proxies/load
# balancers (src/lib/client-ip.ts); Vercel resolves this automatically.
# TRUST_PROXY_DEPTH=1
# Self-host builds (Render/Docker) set standalone output.
# NEXT_OUTPUT="standalone"

# ── Optional integrations (not required for core operation) ──
# WhatsApp Business API credentials (future — current WhatsApp flow is wa.me links, no API needed)
# WHATSAPP_BUSINESS_TOKEN=""
# WHATSAPP_PHONE_ID=""

# Payment gateway credentials (future — current payment methods are manual/COD, no gateway)
# PAYMENT_PROVIDER_KEY=""

# ── Health API (r129) ─────────────────────────────────────────
# /api/health reports which commit is serving (commitSha). Vercel injects
# VERCEL_GIT_COMMIT_SHA automatically; standalone/self-hosted deploys set
# GIT_COMMIT_SHA manually (never fabricated — null when unset).
# GIT_COMMIT_SHA=""
