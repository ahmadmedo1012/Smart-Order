{
  "compilerOptions": {
    "target": "ES2017",
    "lib": [
      "dom",
      "dom.iterable",
      "esnext"
    ],
    "allowJs": true,
    "skipLibCheck": true,
    "strict": true,
    /* r133 (A2 §2-2): the weak-typing escape hatches are closed to match
       the family (SM tsconfig) — noImplicitAny:false was the only place
       the fleet-wide strict contract was disabled, and the 7 ghost
       excludes pointed at dirs that only existed in the sandbox
       workspace, never in this repo. */
    /* r137: tests/unit/*.test.ts import the lib seams with explicit .ts
       specifiers (required by node --test type stripping); tsc must accept
       them (noEmit is already true — the flag requires exactly that). */
    "allowImportingTsExtensions": true,
    "noUnusedLocals": true,
    "noUnusedParameters": true,
    "noEmit": true,
    "esModuleInterop": true,
    "module": "esnext",
    "moduleResolution": "bundler",
    "resolveJsonModule": true,
    "isolatedModules": true,
    "jsx": "react-jsx",
    "incremental": true,
    "plugins": [
      {
        "name": "next"
      }
    ],
    "paths": {
      "@/*": [
        "./src/*"
      ]
    }
  },
  "include": [
    "next-env.d.ts",
    "**/*.ts",
    "**/*.tsx",
    ".next/types/**/*.ts",
    ".next/dev/types/**/*.ts"
  ],
  "exclude": [
    "node_modules"
  ]
}
